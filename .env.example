# Environment variable template
# Copy this file to .env and fill in real values — never commit .env

# Gemma API key (required for AI diagnosis, Phase 3)
GEMMA_API_KEY=

# CLI server port (optional, default 7432)
GIT_CURE_PORT=7432

# Dashboard API base URL (optional, defaults to localhost)
VITE_API_BASE_URL=http://localhost:7432
